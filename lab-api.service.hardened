[Unit]
Description=lab-api (personal compute API)
After=network.target

[Service]
Type=simple
User=ec2-user
ExecStart=/usr/local/bin/lab-api
Restart=on-failure
RestartSec=3s

# Application environment
Environment="SCHOOL_DB_PATH=/var/lib/lab-api/School.db"
Environment="SCHOOL_AUDIT_DB_PATH=/var/lib/lab-api/school-audit.db"
# Comma-separated usernames allowed to access the full School student-detail API.
Environment="LAB_API_ADMIN_USERS=schooladmin"
# Optional non-secret deployment label for /v1/info:
# Environment="LAB_API_ENV=production"

WorkingDirectory=/opt/lab-api

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

# Student database: read-only. Audit database: writable.
ReadOnlyPaths=/var/lib/lab-api/School.db
ReadWritePaths=/var/lib/lab-api/school-audit.db

# Network
RestrictAddressFamilies=AF_INET AF_INET6

# Process / kernel isolation
RestrictNamespaces=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target